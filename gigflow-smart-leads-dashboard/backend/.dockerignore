# Dependencies — always reinstalled inside container
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output — rebuilt inside container
dist/

# Environment files — injected at runtime, never baked into image
.env
.env.*
!.env.example

# Dev / test artifacts
coverage/
.nyc_output/
*.test.ts
*.spec.ts
__tests__/

# Editor & OS noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# Git
.git/
.gitignore

# Docker itself
Dockerfile
.dockerignore

# CI
.github/
